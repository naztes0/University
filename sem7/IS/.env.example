# Copy to .env before the first Compose run. Replace example passwords locally.
# Additional service variables will be added when those services are implemented.

POSTGRES_DB=charging_monitor
POSTGRES_USER=charging_admin
POSTGRES_PASSWORD=replace-with-a-local-password
APP_DB_PASSWORD=replace-with-another-local-password
MONITOR_DB_PASSWORD=replace-with-a-third-local-password

AUTH_ADMIN_USERNAME=operator
AUTH_ADMIN_PASSWORD=replace-with-a-long-local-password
AUTH_SESSION_TTL_SECONDS=28800
# false is required for local HTTP. Use true when the external URL uses HTTPS.
AUTH_COOKIE_SECURE=false

GRAFANA_ADMIN_PASSWORD=replace-with-a-grafana-admin-password
