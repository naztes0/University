cabal-version: 3.0
name:          lab2
version:       0.1.0.0
build-type:    Simple

executable lab2
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    Benchmark, Graph, Menu, ShortestPath
    build-depends:    base >=4.20 && <5,
                      containers >=0.6 && <0.8,
                      deepseq >=1.5 && <1.6,
                      time >=1.12 && <1.16
    ghc-options:      -threaded -rtsopts -Wall
    default-language: Haskell2010

test-suite lab2-tests
    type:             exitcode-stdio-1.0
    main-is:          TestMain.hs
    hs-source-dirs:   test, src
    other-modules:    Benchmark, Graph, ShortestPath
    build-depends:    base >=4.20 && <5,
                      containers >=0.6 && <0.8,
                      deepseq >=1.5 && <1.6,
                      HUnit >=1.6 && <1.7,
                      time >=1.12 && <1.16
    ghc-options:      -threaded -rtsopts -Wall
    default-language: Haskell2010
