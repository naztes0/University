cabal-version: 3.0
name:          lab1
version:       0.1.0.0
build-type:    Simple

executable lab1
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    Database, Menu, Models, Validation
    build-depends:    base >=4.20 && <5,
                      mysql >=0.2.1 && <0.3,
                      mysql-simple >=0.4.9 && <0.5,
                      time >=1.12 && <1.16
    default-language: Haskell2010

test-suite lab1-tests
    type:             exitcode-stdio-1.0
    main-is:          TestMain.hs
    hs-source-dirs:   test, src
    other-modules:    Validation
    build-depends:    base >=4.20 && <5,
                      HUnit >=1.6 && <1.7,
                      time >=1.12 && <1.16
    default-language: Haskell2010

test-suite lab1-integration-tests
    type:             exitcode-stdio-1.0
    main-is:          IntegrationTestMain.hs
    hs-source-dirs:   test-integration, src
    other-modules:    Database, Models
    build-depends:    base >=4.20 && <5,
                      HUnit >=1.6 && <1.7,
                      mysql >=0.2.1 && <0.3,
                      mysql-simple >=0.4.9 && <0.5,
                      time >=1.12 && <1.16
    default-language: Haskell2010

